# ============================================================================
# EVALIX AI — Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================================

# PostgreSQL (Supabase or self-hosted)
DATABASE_URL="postgresql://postgres:password@localhost:5432/evalix"
DIRECT_URL="postgresql://postgres:password@localhost:5432/evalix"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# Google Gemini AI
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_API_KEYS="key1,key2,key3"

# Groq (Llama fallback)
GROQ_API_KEY="your_groq_api_key"

# Brevo (Email)
BREVO_API_KEY="your_brevo_api_key"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"

# App
PORT=3000
FRONTEND_URL="http://localhost:5173"

# n8n Integration
N8N_WEBHOOK_SECRET="your_shared_webhook_secret"